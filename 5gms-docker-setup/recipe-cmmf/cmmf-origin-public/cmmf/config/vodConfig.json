{
  "version": "0.0",
  "ttl": 3600,
  "applicationResourceLocators": [
    {
      "locator": "media/manifest.mpd",
      "contentType": "application/dash+xml",
      "isManifest": true
    }
  ],
  "applicationResourceConfigurations": [
    {
      "admissionRules": {
        "applicationResourcePathPattern": ".*\\.(m4s|mp4|ts)$"
      },
      "exclusionRules": {
        "applicationResourcePathPattern": "^init.*|.*\\.(mpd|m3u8)$"
      },
      "cmmfCodingConfiguration": {
        "cmmfProfile": "org.etsi.cmmf.a",
        "cmmfCodeType": 0,
        "cmmfVersion": 0
      },
      "serviceLocations": [
        {
          "baseUrl": "https://<YOUR_MACHINE_IP_HERE>:8001/",
          "variantId": "cmmf-variant-a",
          "requestPathMaps": [
            {
              "requestPathPattern": "\/(?=[^\/]*$)",
              "mappedPath": "/cmmf-variant-a/"
            }
          ]
        },
        {
          "baseUrl": "https://<YOUR_MACHINE_IP_HERE>:8002/",
          "variantId": "cmmf-variant-b",
          "requestPathMaps": [
            {
              "requestPathPattern": "\/(?=[^\/]*$)",
              "mappedPath": "/cmmf-variant-b/"
            }
          ]
        }
      ]
    }
  ]
}
