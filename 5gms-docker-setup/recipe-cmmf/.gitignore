# Ignore runtime-generated output from AS/AF/AP containers so
# `docker compose up` does not dirty the working tree.
shared/*
!shared/.gitkeep
af-reports/*/
!af-reports/.gitkeep
simple-express-public/watchfolder/
simple-express-public/OLD/

# Generated by application-provider's CmmfVodConfigFormatter (see configs/media.conf)
cmmf-origin-public/cmmf/config/vodConfig.json

# application-provider's M1 data store, including the local CA's private key
m1-client-data/*
!m1-client-data/.gitkeep
